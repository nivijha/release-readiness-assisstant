# Environment Variables for Release Communication and Readiness Brief Assistant

# Server configuration
PORT=5000
# Serve on this port. Defaults to 5000 if not set.

# MongoDB connection
MONGODB_URI=your_mongodb_connection_string
# MongoDB connection string. Required for persistent storage of releases, analyses, and reviews.
# Format: mongodb+srv://username:password@cluster.mongodb.net/databasename
# Example: mongodb+srv://admin:password@cluster0.mongodb.net/release_brief

# Gemini AI API key
GEMINI_API_KEY=your_gemini_api_key
# Gemini API key for AI analysis. Required for AI-powered release analysis.
# The key is used server-side only; never send it to the frontend.
# Get from Google AI Studio: https://makersuite.google.com/app/apikey

# Frontend API URL
VITE_API_URL=http://localhost:5000/api
# Base URL for API calls from the frontend.
# The frontend axios instance uses this base URL to contact the backend.
# Should match the backend server's port and deployment location.

# Optional: Custom CORS origin if needed
# CORS_ORIGIN=http://localhost:5173

# Optional: Environment mode
NODE_ENV=development
# Mode: "development" or "production". Affects some middleware behavior.